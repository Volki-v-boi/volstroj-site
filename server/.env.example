# Скопируй этот файл в server/.env и заполни реальными значениями.
# .env НЕ коммитится в git (проверь .gitignore) — секреты никогда не должны
# попадать в репозиторий.

MONGO_URI=твоя_строка_подключения_к_mongodb_atlas
PORT=5000

TELEGRAM_TOKEN=токен_телеграм_бота
TELEGRAM_CHAT_ID=id_чата_куда_слать_заявки

# Секретный ключ для входа в админку (/admin-volstroy) и защиты
# админских действий (добавление/удаление проектов, модерация отзывов).
# ВАЖНО:
#   - НЕ называй эту переменную с префиксом VITE_ — иначе она попадёт
#     прямо в JS-бандл сайта и будет видна всем в открытом виде.
#   - Придумай длинный случайный пароль, не используй простой словарный.
#   - Это же самое значение нужно будет:
#       1) прописать здесь, в server/.env (для локальной разработки)
#       2) прописать в переменных окружения на хостинге бэкенда
#          (Render/Railway — раздел Environment Variables)
ADMIN_SECRET=придумай_длинный_случайный_пароль_сюда
